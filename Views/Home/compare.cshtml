@{
    ViewData["Title"] = "Compare AI Tools";
}

<section class="compare-page">
    <h1 class="hero-heading">Compare AI Tools</h1>
    @* REWRITE: intro line (1 sentence) *@
    <p class="compare-intro">
        Compare six leading healthcare AI tools side by side, or filter them by their primary capabilities.
    </p>

    <div class="filter-bar">
        <button type="button" class="filter-btn active" data-filter="all">All</button>
        <button type="button" class="filter-btn" data-filter="diagnostics">AI-Powered Diagnostics</button>
        <button type="button" class="filter-btn" data-filter="assistants">Virtual Health Assistants</button>
        <button type="button" class="filter-btn" data-filter="predictive">Predictive Analytics in Medicine</button>
    </div>

    <div class="tool-grid">

        <article class="tool-card" id="tool-aidoc"
                 data-name="Aidoc" data-category="diagnostics" data-category-label="AI-Powered Diagnostics"
                 data-focus="Flagging critical conditions on medical scans"
                 data-users="Hospitals and specialist clinicians"
                 data-access="Enterprise platform for hospitals">
            <img src="/images/aidoc.jpg" alt="Medical scan representing Aidoc" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">AI-Powered Diagnostics</span>
                <h3 class="tool-name">Aidoc</h3>
                <p class="tool-desc">Aidoc uses an AI operating system to analyse medical scans and flag critical conditions in real time. Hospitals and specialists rely on it to streamline workflows, prioritise urgent cases, and improve patient outcomes.</p>
                <a href="https://www.aidoc.com" target="_blank" class="tool-link">Visit website</a>
            </div>
        </article>

        <article class="tool-card" id="tool-vizai"
                 data-name="Viz.ai" data-category="diagnostics" data-category-label="AI-Powered Diagnostics"
                 data-focus="Detecting strokes and other critical conditions on scans"
                 data-users="Hospitals and life sciences companies"
                 data-access="Enterprise platform for hospitals">
            <img src="/images/vizai.jpg" alt="Brain scan representing Viz.ai" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">AI-Powered Diagnostics</span>
                <h3 class="tool-name">Viz.ai</h3>
                <p class="tool-desc">Viz.ai analyses medical scans in seconds to flag critical conditions like strokes and trauma. Hospitals use it to streamline care coordination, while life sciences companies rely on it to accelerate clinical trials.</p>
                <a href="https://www.viz.ai" target="_blank" class="tool-link">Visit website</a>
            </div>
        </article>

        <article class="tool-card" id="tool-ada"
                 data-name="Ada Health" data-category="assistants" data-category-label="Virtual Health Assistants"
                 data-focus="AI symptom assessment and triage guidance"
                 data-users="Individuals seeking health guidance"
                 data-access="Consumer app">
            <img src="/images/ada.jpg" alt="Health app representing Ada Health" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">Virtual Health Assistants</span>
                <h3 class="tool-name">Ada Health</h3>
                <p class="tool-desc">Ada Health provides an AI symptom checker that assesses medical conditions and delivers preliminary triage guidance. Individuals use it to evaluate health issues, navigate care, and prepare for doctor consultations.</p>
                <a href="https://ada.com" target="_blank" class="tool-link">Visit website</a>
            </div>
        </article>

        <article class="tool-card" id="tool-symptomate"
                 data-name="Symptomate" data-category="assistants" data-category-label="Virtual Health Assistants"
                 data-focus="Guided symptom interviews and care recommendations"
                 data-users="Individuals and healthcare organisations"
                 data-access="Free for individuals; licensed to organisations">
            <img src="/images/symptomate.jpg" alt="Digital health representing Symptomate" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">Virtual Health Assistants</span>
                <h3 class="tool-name">Symptomate</h3>
                <p class="tool-desc">Symptomate evaluates health concerns through guided digital interviews to recommend appropriate care. Individuals use it for medical insights, while organisations license it to streamline patient triage.</p>
                <a href="https://infermedica.com" target="_blank" class="tool-link">Visit website</a>
            </div>
        </article>

        <article class="tool-card" id="tool-tempus"
                 data-name="Tempus AI" data-category="predictive" data-category-label="Predictive Analytics in Medicine"
                 data-focus="Precision medicine using clinical and genomic data"
                 data-users="Physicians and pharmaceutical companies"
                 data-access="Clinical lab and data services">
            <img src="/images/tempus.jpg" alt="Genomics lab representing Tempus AI" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">Predictive Analytics in Medicine</span>
                <h3 class="tool-name">Tempus AI</h3>
                <p class="tool-desc">Tempus AI integrates vast clinical datasets with genomic data to drive precision medicine. Physicians use it for targeted therapies, while pharmaceutical companies rely on its analytics to accelerate research.</p>
                <a href="https://www.tempus.com" target="_blank" class="tool-link">Visit website</a>
            </div>
        </article>

        <article class="tool-card" id="tool-merative"
                 data-name="Merative" data-category="predictive" data-category-label="Predictive Analytics in Medicine"
                 data-focus="Healthcare data analytics and software"
                 data-users="Healthcare providers, insurers and life sciences companies"
                 data-access="Enterprise software">
            <img src="/images/merative.jpg" alt="Health data representing Merative" class="tool-img" />
            <div class="tool-body">
                <span class="tool-tag">Predictive Analytics in Medicine</span>
                <h3 class="tool-name">Merative</h3>
                <p class="tool-desc">Merative delivers data analytics and