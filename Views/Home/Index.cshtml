@model IEnumerable<WDP_Assignment.Models.AIImage>

@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1 class="hero-heading">AI in Healthcare</h1>
    <p class="hero-intro">
    Artificial intelligence is transforming healthcare by enabling earlier disease detection, continuous patient support, and proactive risk forecasting before minor health issues escalate into emergencies. By exploring leading diagnostic platforms, AI symptom checkers, and precision medicine tools, our site highlights how these technologies improve patient outcomes and streamline modern clinical workflows.
    <br><em> Adapted from wikipedia</em>
    </p>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">AI-Powered Diagnostics</h3>
        <p class="block-desc">AI diagnostic tools examine X-rays, CT, and MRI scans to spot abnormalities with greater speed and consistency, enabling radiologists to prioritise urgent cases more effectively.</p>
        <a class="read-more" href="https://en.wikipedia.org/wiki/Artificial_intelligence_in_healthcare" target="_blank">Read more</a>
    </div>
    <div class="block-items">
        <a class="square" href="https://www.aidoc.com" target="_blank">
            <img src="/images/aidoc.jpg" alt="Aidoc">
            <span class="caption">Aidoc uses an AI enterprise operating system to analyse medical imaging, flagging critical conditions and accelerating patient care.<br>aidoc.com</span>
        </a>
        <a class="square" href="https://www.viz.ai" target="_blank">
            <img src="/images/vizai.jpg" alt="Viz.ai">
            <span class="caption">Viz.ai provides an AI-powered platform that analyses medical imaging to detect critical conditions and accelerate multidisciplinary care.<br>viz.ai</span>
        </a>
    </div>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">Virtual Health Assistants</h3>
        <p class="block-desc">Powered by machine learning and natural language understanding, virtual health assistants walk users through their symptoms, deliver initial assessments, and guide care decisions.</p>
        <a class="read-more" href="https://ada.com" target="_blank">Read more</a>
    </div>
    <div class="block-items">
        <a class="square" href="https://ada.com" target="_blank">
            <img src="/images/ada.jpg" alt="Ada Health">
            <span class="caption">Ada Health provides an AI symptom assessment platform to help individuals understand their health conditions and navigate care.<br>ada.com</span>
        </a>
        <a class="square" href="https://infermedica.com" target="_blank">
            <img src="/images/symptomate.jpg" alt="Symptomate">
            <span class="caption">Symptomate helps people understand their health concerns through an interactive assessment and guides them to appropriate care.<br>infermedica.com</span>
        </a>
    </div>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">Predictive Analytics in Medicine</h3>
        <p class="block-desc">Predictive analytics uses artificial intelligence to examine extensive clinical and molecular records, anticipating patient outcomes and tailoring treatments to enable earlier, highly personalised care.</p>
        <a class="read-more" href="https://en.wikipedia.org/wiki/Precision_medicine" target="_blank">Read more</a>
    </div>
    <div class="block-items">
        <a class="square" href="https://www.tempus.com" target="_blank">
            <img src="/images/tempus.jpg" alt="Tempus AI">
            <span class="caption">Tempus AI combines genomic sequencing with artificial intelligence to power precision medicine and personalise patient care.<br>tempus.com</span>
        </a>
        <a class="square" href="https://www.merative.com" target="_blank">
            <img src="/images/merative.jpg" alt="Merative">
            <span class="caption">Merative delivers data analytics, software, and AI solutions to streamline healthcare operations, research, and social programs.<br>merative.com</span>
        </a>
    </div>
</section>

<section class="upload-block">
    <h2 class="upload-heading">Upload AI Images</h2>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a class="upload-text" asp-controller="AIImages" asp-action="Create">
            Click here to upload a new AI image
        </a>
    }
    else
    {
        <p class="upload-text">
            Please <a asp-area="Identity" asp-page="/Account/Login">login</a>
            or <a asp-area="Identity" asp-page="/Account/Register">register</a>
            to upload your AI images.
        </p>
    }

    @if (Model != null && Model.Any())
    {
        <div class="gallery-grid">
            @foreach (var item in Model)
            {
                <a class="gallery-tile" asp-controller="AIImages" asp-action="Index" asp-fragment="img-@item.Id">
                    <img src="/uploads/@item.Filename" alt="@item.Prompt" />
                    <span class="gallery-label">@item.ImageGenerator</span>
                </a>
            }
        </div>
    }
</section>
