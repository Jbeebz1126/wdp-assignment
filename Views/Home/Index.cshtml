@model IEnumerable<WDP_Assignment.Models.AIImage>

@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1 class="hero-heading">AI in Healthcare</h1>
    <p class="hero-intro">
        Artificial intelligence is reshaping modern medicine — helping clinicians detect
        disease earlier, support patients around the clock, and predict health risks before
        they become emergencies.
        <br><em>Adapted from Wikipedia</em>
    </p>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">AI-Powered Diagnostics</h3>
        <p class="block-desc">AI diagnostic tools analyse medical images such as X-rays, CT and MRI scans to detect abnormalities faster and more consistently, helping radiologists prioritise urgent cases.</p>
        <a class="read-more" href="https://en.wikipedia.org/wiki/Artificial_intelligence_in_healthcare" target="_blank">Read more</a>
    </div>
    <div class="block-items">
                <a class="square" href="https://www.aidoc.com" target="_blank">
            <img src="/images/aidoc.jpg" alt="Aidoc">
            <span class="caption">Aidoc uses an AI enterprise operating system to analyse medical imaging, flagging critical conditions and accelerating patient care<br>aidoc.com</span>
        </a>
        <a class="square" href="https://www.viz.ai" target="_blank">
            <img src="/images/vizai.jpg" alt="Viz.ai">
            <span class="caption">Viz.ai uses AI to detect conditions like stroke on scans and alert specialists in real time.<br>Wikipedia</span>
        </a>
    </div>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">Virtual Health Assistants</h3>
        <p class="block-desc">Virtual health assistants use natural language understanding and machine learning to guide patients through symptoms, offer preliminary assessments, and suggest next steps.</p>
        <a class="read-more" href="https://ada.com" target="_blank">Read more</a>
    </div>
    <div class="block-items">
        <a class="square" href="https://ada.com" target="_blank">
            <img src="/images/ada.jpg" alt="Ada Health">
            <span class="caption">Ada Health is an AI symptom-assessment app that suggests possible causes and next steps.<br>Wikipedia</span>
        </a>
        <a class="square" href="https://symptomate.com" target="_blank">
            <img src="/images/symptomate.jpg" alt="Symptomate">
            <span class="caption">Symptomate, by Infermedica, is an AI symptom checker that points users toward appropriate care.<br>Wikipedia</span>
        </a>
    </div>
</section>

<section class="ai-block reveal">
    <div class="block-text">
        <h3 class="block-heading">Predictive Analytics in Medicine</h3>
        <p class="block-desc">Predictive analytics applies AI to large clinical and molecular datasets to forecast patient outcomes and personalise treatment, supporting earlier, more precise care.</p>
        <a class="read-more" href="https://en.wikipedia.org/wiki/Precision_medicine" target="_blank">Read more</a>
    </div>
    <div class="block-items">
        <a class="square" href="https://www.tempus.com" target="_blank">
            <img src="/images/tempus.jpg" alt="Tempus">
            <span class="caption">Tempus applies AI to clinical and molecular data to advance precision medicine.<br>Wikipedia</span>
        </a>
        <a class="square" href="https://www.merative.com" target="_blank">
            <img src="/images/merative.jpg" alt="Merative">
            <span class="caption">Merative, formerly IBM Watson Health, provides data and AI tools for healthcare decisions.<br>Wikipedia</span>
        </a>
    </div>
</section>

<section class="upload-block">
    <h2 class="upload-heading">Upload AI Images</h2>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a class="upload-text" asp-controller="AIImages" asp-action="Create">
            Click here to upload a new AI image
        </a>
    }
    else
    {
        <p class="upload-text">
            Please <a asp-area="Identity" asp-page="/Account/Login">login</a>
            or <a asp-area="Identity" asp-page="/Account/Register">register</a>
            to upload your AI images.
        </p>
    }

    @if (Model != null && Model.Any())
    {
        <div class="gallery-grid">
            @foreach (var item in Model)
            {
                <a class="gallery-tile" asp-controller="AIImages" asp-action="Index" asp-fragment="img-@item.Id">
                    <img src="/uploads/@item.Filename" alt="@item.Prompt" />
                    <span class="gallery-label">@item.ImageGenerator</span>
                </a>
            }
        </div>
    }
</section>
