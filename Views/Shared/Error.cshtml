@model WDP_Assignment.Models.ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<section class="form-page">
    <h1 class="form-heading">Oops!</h1>
    <div class="error-box">
        <p class="error-text">Sorry, something went wrong, or the page you were looking for could not be found.</p>
        <p class="error-text">Please return to the <a asp-controller="Home" asp-action="Index">home page</a> and try again.</p>
        @if (Model != null && Model.ShowRequestId)
        {
            <p class="error-ref">Reference: <code>@Model.RequestId</code></p>
        }
    </div>
</section>
