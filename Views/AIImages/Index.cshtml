@model IEnumerable<WDP_Assignment.Models.AIImage>

@{
    ViewData["Title"] = "AI Images";
    bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
    bool isAdmin = User.IsInRole("Admin");
    int rowNumber = 0;
}

<section class="list-hero">
    <h1 class="hero-heading">List of AI Images</h1>
    @if (isLoggedIn)
    {
        <a class="list-upload-link" asp-action="Create">Click here to upload a new AI image</a>
    }
    else
    {
        <p class="list-upload-link">
            Please <a asp-area="Identity" asp-page="/Account/Login">login</a>
            or <a asp-area="Identity" asp-page="/Account/Register">register</a>
            to upload your AI images.
        </p>
    }
</section>

@if (!Model.Any())
{
    <p class="empty-list">No AI images yet. Log in and upload the first one.</p>
}

@foreach (var item in Model)
{
    var rowClass = rowNumber % 2 == 0 ? "image-row row-orange" : "image-row row-blue reverse";
    rowNumber++;

    <article id="img-@item.Id" class="@rowClass">
        <div class="image-row-pic" data-bg="/uploads/@item.Filename" role="img" aria-label="@item.Prompt"></div>
        <div class="image-row-text">
            <h3 class="image-row-heading">@item.ImageGenerator</h3>
            <p class="image-row-prompt">@item.Prompt</p>

            @if (isLoggedIn)
            {
                <div class="image-row-buttons">
                    <form asp-action="Like" asp-route-id="@item.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!item.canIncreaseLike)">
                            Like (@item.Like)
                        </button>
                    </form>
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    }
                </div>
            }
        </div>
    </article>
}