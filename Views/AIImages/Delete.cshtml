@model WDP_Assignment.Models.AIImage

@{
    ViewData["Title"] = "Delete AI Image";
}

<section class="form-page">
    <h1 class="form-heading">Delete AI Image</h1>

    <div class="delete-box">
        <h3 class="delete-question">Are you sure you want to delete this?</h3>
        <div asp-validation-summary="All" class="text-danger"></div>

        <dl class="row delete-details">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Prompt)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Prompt)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ImageGenerator)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ImageGenerator)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UploadDate)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UploadDate)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Filename)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Filename)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Like)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Like)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <span class="delete-sep">|</span>
            <a asp-action="Index" class="back-link">Back to List</a>
        </form>
    </div>
</section>
